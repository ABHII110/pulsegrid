# Copy to .env and fill in real values. Never commit .env.

# development | test | production
PULSEGRID_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PULSEGRID_LOG_LEVEL=INFO
# true = JSON log lines (production), false = coloured console output (local dev)
PULSEGRID_LOG_JSON=false

# SQLite works out of the box for a single node; use PostgreSQL in production:
#   postgresql+asyncpg://pulsegrid:<password>@localhost:5432/pulsegrid
PULSEGRID_DATABASE_URL=sqlite+aiosqlite:///./pulsegrid.db
PULSEGRID_DB_ECHO=false
# Only used by docker-compose.yml, which builds the PostgreSQL URL from it.
POSTGRES_PASSWORD=

# Optional. When set, workers coordinate through Redis locks so several replicas never
# probe the same monitor at once. Leave empty for a single worker process.
PULSEGRID_REDIS_URL=

# Required to run the REST API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PULSEGRID_API_KEY=
PULSEGRID_API_HOST=127.0.0.1
PULSEGRID_API_PORT=8000
# Keep /docs and /openapi.json available when ENVIRONMENT=production.
PULSEGRID_EXPOSE_DOCS=false
# Single-service hosting: run the probe worker inside the API process.
PULSEGRID_EMBEDDED_WORKER=false
# Apply database migrations automatically when `pulsegrid serve` starts.
PULSEGRID_MIGRATE_ON_START=false

# Probing
PULSEGRID_ALLOW_PRIVATE_TARGETS=false
PULSEGRID_PROBE_USER_AGENT=PulseGrid/0.1

# Worker
PULSEGRID_WORKER_POLL_INTERVAL_SECONDS=5
PULSEGRID_WORKER_CONCURRENCY=20
PULSEGRID_WORKER_BATCH_SIZE=200

# Optional incident webhook. Payloads are signed with HMAC-SHA256 when a secret is set
# (header: X-PulseGrid-Signature: sha256=<hex>).
PULSEGRID_WEBHOOK_URL=
PULSEGRID_WEBHOOK_SECRET=
PULSEGRID_WEBHOOK_TIMEOUT_SECONDS=5
